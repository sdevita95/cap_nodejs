{
  "name": "testRename",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.14.3",
    "@cap-js/hana": "^1",
    "@sap-cloud-sdk/connectivity": "^4.0.2",
    "@sap-cloud-sdk/core": "^1.54.2",
    "@sap-cloud-sdk/http-client": "^3",
    "@sap-cloud-sdk/resilience": "^3",
    "@sap/cds": "^9.2.0",
    "@sap/hana-client": "^2.24.24",
    "@sap/xssec": "^4",
    "express": "^4",
    "g": "^2.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.10.0",
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "9.2.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-testrename-uimodule": "cds watch --open testrename-uimodule/webapp/index.html?sap-ui-xx-viewCache=false",
    "start-hybrid": "cds run --profile hybrid && open http://localhost:4004/testrename-uimodule/webapp/index.html?sap-ui-xx-viewCache=false"
  },
  "cds": {
    "db": {
      "kind": "hana"
    },
    "requires": {
      "auth": "xsuaa",
      "northwind": {
        "kind": "odata-v2",
        "model": "srv/external/northwind",
        "credentials": {
          "url": "https://services.odata.org/V2/Northwind/Northwind.svc/"
        }
      }
    }
  }
}
